# Ricezione dei moduli del sito.
#
# Copiare questo file in `.env.local` e riempire i cinque valori: sono
# quelli del fornitore di posta su cui gira gia' info@paloryn.com.
# `.env.local` non finisce in git — e non deve finirci.
#
# Senza questi valori il sito resta in piedi: i moduli rispondono con un
# errore dichiarato e mostrano l'indirizzo da copiare a mano. Non fingono
# mai di aver spedito.

# IL FORNITORE E' REGISTER.IT — ricavato dai DNS del dominio, non chiesto
# a nessuno: paloryn.com ha MX = mail.register.it e SPF =
# include:spf.webapps.net, che e' l'infrastruttura di Register.
#
# Register espone due server per la posta in uscita. Esistono tutti e due
# (verificato in DNS), e quale dei due accetta l'accesso dipende dal piano
# della casella:
#
#     authsmtp.register.it   81.88.48.66      relay autenticato
#     smtp.register.it       195.110.124.132  stesso IP di mail.register.it
#
# Non serve indovinare: si mette il primo, si lancia
# `node scripts/prova-posta.mjs` e in cinque secondi si sa se e' quello.
# Se rifiuta, si prova l'altro, e poi 587 al posto di 465.
#
# LA PASSWORD e' l'unica cosa che non si ricava da fuori. Sta nel pannello
# di Register, nella gestione della casella info@paloryn.com. Se la casella
# ha la verifica in due passaggi, quella normale non funziona: serve una
# password dedicata alle applicazioni.

SMTP_HOST=authsmtp.register.it
SMTP_PORT=465          # 465 con TLS diretto, 587 con STARTTLS
SMTP_USER=info@paloryn.com
SMTP_PASS=             # meglio una password per applicazioni, non quella del pannello
CONTACT_TO=info@paloryn.com
